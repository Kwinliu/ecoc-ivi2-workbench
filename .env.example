# Copy to .env for local production connector configuration.
# Do not commit real API keys, private keys, client certificates, or passwords.

# Safehomo's single InfoCert STAGE platform connection.
INFOCERT_STAGE_OAUTH_URL=https://idpstage.infocert.digital/auth/realms/delivery/protocol/openid-connect/token
INFOCERT_STAGE_API_BASE_URL=https://apistage.infocert.digital/signature/v1
INFOCERT_STAGE_CLIENT_ID=
INFOCERT_STAGE_CLIENT_SECRET=
INFOCERT_STAGE_APPLICATION_ID=desktop-signer
INFOCERT_STAGE_OAUTH_SCOPE=signature

# Manufacturer certificate profile example.
# Add one group for each OEM or formal representative certificate. The prefix
# must match the certificate profile configured in the workbench.
INFOCERT_CERT_EXAMPLE_OEM_SIGNER_ID=
INFOCERT_CERT_EXAMPLE_OEM_CERTIFICATE_ID=
INFOCERT_CERT_EXAMPLE_OEM_PIN=
INFOCERT_CERT_EXAMPLE_OEM_SAT=
INFOCERT_CERT_EXAMPLE_OEM_CERTIFICATE_PEM_PATH=

# Local acceptance tests only. Never enable this in a production deployment.
INFOCERT_STAGE_MOCK=false

# NAP upload endpoints and API keys.
RDW_UPLOAD_ENDPOINT=
RDW_UPLOAD_API_KEY=
KBA_UPLOAD_ENDPOINT=
KBA_UPLOAD_API_KEY=
VCA_UPLOAD_ENDPOINT=
VCA_UPLOAD_API_KEY=

# Optional mTLS certificate material for NAP upload connectors.
RDW_CLIENT_CERT_PATH=
RDW_CLIENT_KEY_PATH=
KBA_CLIENT_CERT_PATH=
KBA_CLIENT_KEY_PATH=
VCA_CLIENT_CERT_PATH=
VCA_CLIENT_KEY_PATH=
